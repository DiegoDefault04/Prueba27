# Puerto en el que se expone la aplicación con Docker Compose (http://localhost:8080)
WEB_PORT=8080

# --- Solo para ejecución local sin Docker (backend/.env o variables de entorno) ---
# Puerto de la API
PORT=3001
# Ruta del archivo SQLite
DATABASE_PATH=./data/app.db
# Origen permitido por CORS (en desarrollo basta con el proxy de Vite)
CORS_ORIGIN=*
